# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.venv/
venv/
# Python build output (root only — viewer/dist is a committed artifact)
/build/
/dist/

# Node
node_modules/

# Generated GeoJSON intermediates (the make_*.py scripts rebuild these from the
# committed source data in examples/data/). The .pmtiles archives, the committed
# source data, and viewer/dist/* ARE tracked so the demo works straight after
# clone — rebuild data with examples/make_arctic.py and the bundle with
# `npm run build:viewer`.
examples/arctic.geojson
examples/canada.geojson

# OS / editor
.DS_Store
*.swp

# Real OSM extracts/products downloaded by the demo build scripts (the .pmtiles
# artifacts are committed, the bulky sources are not). The Greenland extract is
# shared by make_greenland.py and make_arctic.py; the land polygons feed the
# circumpolar coastline in make_arctic.py.
examples/data/greenland-latest.osm.pbf
examples/data/simplified-land-polygons-3857.zip
examples/data/simplified-land-polygons-complete-3857/
